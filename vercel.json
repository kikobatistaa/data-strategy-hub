{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/pt", "destination": "/pt/index.html" },
    { "source": "/es", "destination": "/es/index.html" },
    { "source": "/thesis", "destination": "/thesis/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/projects/bid", "destination": "/projects/bid/index.html" },
    { "source": "/projects/bank", "destination": "/projects/bank/index.html" },
    { "source": "/projects/spark-analytics/traffic", "destination": "/projects/spark-analytics/traffic/index.html" },
    { "source": "/projects/spark-analytics/spotify", "destination": "/projects/spark-analytics/spotify/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
